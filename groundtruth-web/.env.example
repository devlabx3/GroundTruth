# Supabase (Auth, Storage, Realtime) — SOLO estos usos, nunca consultas de negocio directas
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend NestJS (toda la lógica de negocio via Axios)
VITE_API_BASE_URL=http://localhost:3000
# Solana
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=

# ─── Accesos rápidos por rol en el login (OPCIONAL) ────────────────────────────
# Pintan un botón por rol debajo del formulario que entra por el flujo REAL
# (Supabase Auth → /me → rol derivado). Sirven para depurar privilegios sin
# teclear credenciales, y para enseñar la app sin repartir contraseñas.
#
# En `pnpm dev` aparecen solos. Para un build de producción hace falta además:
#   VITE_DEV_LOGINS=true
#
# ⚠ SEGURIDAD: con esa marca, las credenciales viajan EN CLARO dentro del bundle.
#   Vite sustituye cada import.meta.env.X por su literal al compilar: no son un
#   secreto de servidor, sino texto plano que cualquiera lee abriendo el código
#   fuente de la página. Quien tenga la URL tiene las contraseñas.
#
#   Si lo activas en un entorno público, usa cuentas de DEMO desechables con datos
#   de juguete — y piensa dos veces antes de incluir la de admin, que cruza unidades.
#   Sin `VITE_DEV_LOGINS`, Vite elimina la rama entera y las contraseñas no llegan
#   al bundle (verificado).
#
# Un rol sin email o sin contraseña no se ofrece: basta no definirlo para quitarlo.
VITE_DEV_LOGINS=
VITE_DEV_OPERADOR_EMAIL=
VITE_DEV_OPERADOR_PASSWORD=
VITE_DEV_LOGISTICA_EMAIL=
VITE_DEV_LOGISTICA_PASSWORD=
VITE_DEV_AGRICULTOR_EMAIL=
VITE_DEV_AGRICULTOR_PASSWORD=
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=
